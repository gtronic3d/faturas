    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1",
    "jsqr": "^1.4.0"
  }
}