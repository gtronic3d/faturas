  "private": true,
  "description": "MVP: extração e registo de dados de faturas a partir de fotografia (PWA local, offline).",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "start": "node scripts/serve.mjs",
